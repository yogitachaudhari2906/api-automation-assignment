{
  "info": {
    "name": "Task 3 - Postman Automation (JSONPlaceholder)",
    "description": "GET, POST and DELETE tests for https://jsonplaceholder.typicode.com/posts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" },
    { "key": "postTitle", "value": "API Automation Assignment" },
    { "key": "postBody", "value": "Created from Postman collection for Task 3" },
    { "key": "postId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET /posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a non-empty array\", function () {",
              "    const posts = pm.response.json();",
              "    pm.expect(posts).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test(\"Each post has userId, id, title and body\", function () {",
              "    pm.response.json().forEach(function (post) {",
              "        pm.expect(post).to.have.all.keys('userId', 'id', 'title', 'body');",
              "    });",
              "});",
              "",
              "pm.test(\"Response time is less than 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": ["{{baseUrl}}"],
          "path": ["posts"]
        }
      }
    },
    {
      "name": "POST /posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains the same title\", function () {",
              "    pm.expect(json.title).to.eql(pm.collectionVariables.get('postTitle'));",
              "});",
              "",
              "pm.test(\"Response contains the same body\", function () {",
              "    pm.expect(json.body).to.eql(pm.collectionVariables.get('postBody'));",
              "});",
              "",
              "pm.test(\"Response contains userId and a new id\", function () {",
              "    pm.expect(json.userId).to.eql(1);",
              "    pm.expect(json).to.have.property('id');",
              "});",
              "",
              "// Save the new id for the DELETE request",
              "pm.collectionVariables.set('postId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json; charset=UTF-8" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"{{postTitle}}\",\n    \"body\": \"{{postBody}}\",\n    \"userId\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": ["{{baseUrl}}"],
          "path": ["posts"]
        }
      }
    },
    {
      "name": "DELETE /posts/{id}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 or 204\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "pm.test(\"Response time is less than 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": ["{{baseUrl}}"],
          "path": ["posts", "{{postId}}"]
        }
      }
    }
  ]
}
